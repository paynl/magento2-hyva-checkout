<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.payment.methods">
            <!--
                Generic Pay. payment methods are registered automatically as
                children of this block by
                Paynl\HyvaCheckout\Observer\RegisterPaynlPaymentMethods
                (see etc/frontend/events.xml, layout_generate_blocks_after).

                Only methods that need a non-generic renderer are declared
                here. Any child block declared in layout XML takes precedence
                over the auto-registered generic block.
            -->
            <block name="checkout.payment.method.paynl_payment_ideal"
                   as="paynl_payment_ideal"
                   template="Paynl_HyvaCheckout::component/payment/method/ideal.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Paynl\HyvaCheckout\Magewire\Checkout\Payment\Method\Ideal
                    </argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="helper" helper="Paynl\HyvaCheckout\Helper\PaymentIcon::getIconUrl">
                                <param name="methodCode">paynl_payment_ideal</param>
                            </item>
                            <item name="attributes" xsi:type="array">
                                <item name="width" xsi:type="string">35px</item>
                                <item name="loading" xsi:type="string">lazy</item>
                                <item name="alt" xsi:type="helper" helper="Paynl\HyvaCheckout\Helper\PaymentIcon::getIconAltText">
                                    <param name="methodCode">paynl_payment_ideal</param>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.paynl_payment_instore"
                   as="paynl_payment_instore"
                   template="Paynl_HyvaCheckout::component/payment/method/ideal.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Paynl\HyvaCheckout\Magewire\Checkout\Payment\Method\Pin
                    </argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="helper" helper="Paynl\HyvaCheckout\Helper\PaymentIcon::getIconUrl">
                                <param name="methodCode">paynl_payment_instore</param>
                            </item>
                            <item name="attributes" xsi:type="array">
                                <item name="width" xsi:type="string">35px</item>
                                <item name="loading" xsi:type="string">lazy</item>
                                <item name="alt" xsi:type="helper" helper="Paynl\HyvaCheckout\Helper\PaymentIcon::getIconAltText">
                                    <param name="methodCode">paynl_payment_instore</param>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceBlock>

        <referenceContainer name="magewire.plugin.scripts">
            <block name="checkout.payment.methods.after.paynl_payment_configuration"
                   as="paynl_payment_configuration"
                   template="Paynl_HyvaCheckout::component/payment/method/configuration.phtml"/>
        </referenceContainer>
    </body>
</page>
